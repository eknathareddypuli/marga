[
 {
  "id": "pt-cat",
  "module": "platform-tools",
  "lesson": "platform-tools/backstage-software-catalog-and-templates",
  "title": "Is the portal trusted?",
  "summary": "Check what keeps a developer portal accurate.",
  "inputs": [
   {
    "id": "a",
    "label": "Owners validated",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Metadata in each repository",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Templates versioned",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Adoption tracked",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Owners",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'real owners' : 'orphaned'"
   },
   {
    "id": "n1",
    "label": "Metadata",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'with code' : 'separate'"
   },
   {
    "id": "n2",
    "label": "Templates",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'versioned' : 'copied'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Unowned entries make the portal useless in an incident."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Owners are valid but metadata, templates or adoption data drift."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Owners, metadata, templates and adoption are managed."
   }
  ],
  "tries": [
   "Turn on only \"Owners validated\".",
   "Turn on all four.",
   "Turn on everything except \"Adoption tracked\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
