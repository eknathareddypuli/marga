[
 {
  "id": "fo-cycle",
  "module": "finops",
  "lesson": "finops/the-finops-cycle-inform-optimize-operate",
  "title": "Is cost owned and visible?",
  "summary": "Toggle the habits that make cloud cost a shared topic.",
  "inputs": [
   {
    "id": "a",
    "label": "Cost per unit tracked",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Every cost has an owner",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Weekly team report",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Cost in design reviews",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Unit cost",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'per unit' : 'total only'"
   },
   {
    "id": "n1",
    "label": "Owner",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'owned' : 'unowned'"
   },
   {
    "id": "n2",
    "label": "Report",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'weekly' : 'yearly'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Nobody owns the bill, so nothing changes."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Some habits exist but cost is still not a design input."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Cost is visible, owned and part of design."
   }
  ],
  "tries": [
   "Turn on only \"Cost per unit tracked\".",
   "Turn on all four.",
   "Turn on everything except \"Cost in design reviews\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
