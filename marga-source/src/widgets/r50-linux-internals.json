[
 {
  "id": "li-cgroup",
  "module": "linux-internals",
  "lesson": "linux-internals/cgroup-v2-controllers-cpu-throttling-and-memory-limits",
  "title": "Will limits cause surprises?",
  "summary": "Check the settings that avoid throttling and kills.",
  "inputs": [
   {
    "id": "a",
    "label": "Threads match CPU request",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Throttling alert",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Memory above peak use",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Pressure files watched",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Threads",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'matched' : 'too many'"
   },
   {
    "id": "n1",
    "label": "Alert",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'alerting' : 'blind'"
   },
   {
    "id": "n2",
    "label": "Memory",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'headroom' : 'tight'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "The service will be throttled or killed."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Some limit risks remain."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Limits match how the service runs."
   }
  ],
  "tries": [
   "Turn on only \"Threads match CPU request\".",
   "Turn on all four.",
   "Turn on everything except \"Pressure files watched\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
