[
 {
  "id": "mc-map",
  "module": "multi-cloud",
  "lesson": "multi-cloud/service-mapping-compute-storage-and-databases",
  "title": "Is the mapping reliable?",
  "summary": "Check habits that prevent cloud mismatches.",
  "inputs": [
   {
    "id": "a",
    "label": "Mapping table with differences",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Limits and quotas checked",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Redundancy set explicitly",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Behaviour tested",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Mapping",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'documented' : 'assumed'"
   },
   {
    "id": "n1",
    "label": "Limits",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'checked' : 'unknown'"
   },
   {
    "id": "n2",
    "label": "Redundancy",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'explicit' : 'default'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Assuming equal behaviour causes duplicate messages and surprises."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "The mapping exists but checks or tests are missing."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Mapping, limits, redundancy and tests are covered."
   }
  ],
  "tries": [
   "Turn on only \"Mapping table with differences\".",
   "Turn on all four.",
   "Turn on everything except \"Behaviour tested\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
  "id": "mc-net",
  "module": "multi-cloud",
  "lesson": "multi-cloud/networking-vpc-vnet-peering-and-hybrid-connectivity",
  "title": "Will the networks connect?",
  "summary": "Toggle the design checks that keep two clouds connected.",
  "inputs": [
   {
    "id": "a",
    "label": "Address ranges registered",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Hub for many networks",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Private DNS linked",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Two cross cloud paths",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "CIDR",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'unique' : 'overlapping'"
   },
   {
    "id": "n1",
    "label": "Routing",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'hub' : 'mesh'"
   },
   {
    "id": "n2",
    "label": "DNS",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'linked' : 'missing'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Overlapping ranges cannot be fixed by routing alone."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Ranges are fine but DNS or link redundancy may break access."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Addresses, hub, DNS and redundancy are in place."
   }
  ],
  "tries": [
   "Turn on only \"Address ranges registered\".",
   "Turn on all four.",
   "Turn on everything except \"Two cross cloud paths\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
  "id": "mc-iam",
  "module": "multi-cloud",
  "lesson": "multi-cloud/identity-and-access-iam-entra-and-federation",
  "title": "Is identity under control?",
  "summary": "Choose the identity practices that remove long lived keys.",
  "inputs": [
   {
    "id": "a",
    "label": "Single identity provider",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "OIDC for pipelines",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Least privilege scopes",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Break glass account",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Source",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'federated' : 'separate users'"
   },
   {
    "id": "n1",
    "label": "CI",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'keyless' : 'stored keys'"
   },
   {
    "id": "n2",
    "label": "Scope",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'scoped' : 'owner'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Separate local users and keys multiply the risk."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Identity is federated but scopes or emergency access are weak."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Federation, keyless CI, scoped roles and break glass."
   }
  ],
  "tries": [
   "Turn on only \"Single identity provider\".",
   "Turn on all four.",
   "Turn on everything except \"Break glass account\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
