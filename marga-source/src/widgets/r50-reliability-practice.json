[
 {
  "id": "rp-sli",
  "module": "reliability-practice",
  "lesson": "reliability-practice/choosing-slis-by-service-type",
  "title": "Does the SLI match users?",
  "summary": "Toggle the properties of a good indicator.",
  "inputs": [
   {
    "id": "a",
    "label": "Good over valid events",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Latency threshold included",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Health checks excluded",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Measured near the user",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Shape",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'ratio' : 'raw metric'"
   },
   {
    "id": "n1",
    "label": "Latency",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'included' : 'success only'"
   },
   {
    "id": "n2",
    "label": "Valid",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'excluded' : 'included'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "The dashboard will be green while users suffer."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "The indicator has blind spots."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "The indicator reflects user experience."
   }
  ],
  "tries": [
   "Turn on only \"Good over valid events\".",
   "Turn on all four.",
   "Turn on everything except \"Measured near the user\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
