[
 {
  "id": "id-method",
  "module": "infra-design",
  "lesson": "infra-design/designing-for-operators-requirements-day-two-and-the-design-review",
  "title": "Is the design reviewable?",
  "summary": "Toggle the parts of a good infrastructure design document.",
  "inputs": [
   {
    "id": "a",
    "label": "Users and numbers",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Non goals written",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Blast radius analysed",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Day two plan",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Requirements",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'numbers' : 'guesses'"
   },
   {
    "id": "n1",
    "label": "Scope",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'written' : 'implied'"
   },
   {
    "id": "n2",
    "label": "Failure",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'analysed' : 'unknown'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "The design will fail in operation."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Some design questions are unanswered."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "The design can be reviewed and operated."
   }
  ],
  "tries": [
   "Turn on only \"Users and numbers\".",
   "Turn on all four.",
   "Turn on everything except \"Day two plan\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
