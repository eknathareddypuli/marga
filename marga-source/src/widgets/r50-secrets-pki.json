[
 {
  "id": "sp-life",
  "module": "secrets-pki",
  "lesson": "secrets-pki/the-secret-lifecycle-inventory-ownership-and-rotation",
  "title": "Is the secret lifecycle managed?",
  "summary": "Toggle the practices that keep secrets owned and replaceable.",
  "inputs": [
   {
    "id": "a",
    "label": "Inventory with owners",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Ranked by blast radius",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Rotation with two versions",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Leak plan practised",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Inventory",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'owned' : 'unknown'"
   },
   {
    "id": "n1",
    "label": "Rank",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'ranked' : 'equal'"
   },
   {
    "id": "n2",
    "label": "Rotation",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'overlap' : 'outage'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "A leak cannot be handled safely."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Some lifecycle steps are missing."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Secrets are owned and replaceable."
   }
  ],
  "tries": [
   "Turn on only \"Inventory with owners\".",
   "Turn on all four.",
   "Turn on everything except \"Leak plan practised\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
