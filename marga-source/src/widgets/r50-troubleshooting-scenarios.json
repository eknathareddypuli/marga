[
 {
  "id": "ts-method",
  "module": "troubleshooting-scenarios",
  "lesson": "troubleshooting-scenarios/a-symptom-first-method-narrow-the-layer-in-ten-minutes",
  "title": "Is the method disciplined?",
  "summary": "Toggle the habits that make incident debugging repeatable.",
  "inputs": [
   {
    "id": "a",
    "label": "Symptom written precisely",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "What changed checked",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "One change at a time",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Results recorded",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Symptom",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'precise' : 'vague'"
   },
   {
    "id": "n1",
    "label": "Change",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'checked' : 'skipped'"
   },
   {
    "id": "n2",
    "label": "Tests",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'serial' : 'parallel'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Guessing will extend the outage."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "The method is only partly followed."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "The search space shrinks with every test."
   }
  ],
  "tries": [
   "Turn on only \"Symptom written precisely\".",
   "Turn on all four.",
   "Turn on everything except \"Results recorded\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
